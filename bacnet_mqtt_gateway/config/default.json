{
    "mqtt": {
        "gatewayId": "default-bacnet-gateway",
        "host": "localhost",
        "port": 1883,
        "username": "",
        "password": "",
        "tls": {
            "enabled": false,
            "caPath": "",
            "certPath": "",
            "keyPath": "",
            "rejectUnauthorized": true
        }
    },
    "bacnet": {
        "configFolder": "/config/devices/",
        "interface": "0.0.0.0",
        "broadcastAddress": "255.255.255.255",
        "port": 47808,
        "apduTimeout": 10000,
        "maxSegments": 112,
        "maxApdu": 5
    },
    "polling": {
        "globalConcurrency": 2,
        "objectConcurrency": 4,
        "schedulerTickMs": 1000,
        "defaultFreshnessMs": 30000,
        "failureThreshold": 3,
        "baseBackoffMs": 5000,
        "maxBackoffMs": 120000,
        "classIntervals": {
            "fast": 5000,
            "normal": 15000,
            "slow": 60000
        }
    },
    "httpServer": {
        "enabled": true,
        "port": 18082
    },
    "openapi": {
        "serverUrl": ""
    },
    "logger": {
        "level": "info"
    },
    "auth": {
        "dbPath": "/data/auth.db",
        "jwtSecret": "",
        "tokenExpiresIn": "1h",
        "trustIngress": false,
        "ingressSource": "172.30.32.2"
    },
    "runtime": {
        "dbPath": "/data/runtime.db"
    }
}
